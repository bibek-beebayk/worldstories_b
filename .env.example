# Django
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ENV=development
SITE_URL=https://worldstories.net

# PostgreSQL
PGDATABASE=stories_db
PGUSER=postgres
PGPASSWORD=replace-with-your-database-password
PGHOST=127.0.0.1
PGPORT=5432

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
AWS_S3_CUSTOM_DOMAIN=

ANTHROPIC_API_KEY=

# Shared secret with the frontend's SSR loaders — must match the frontend's
# own SSR_INTERNAL_API_KEY. See core/libs/throttling.py.
SSR_INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Social media analytics (apps/social_media_analytics)
# ---------------------------------------------------------------------------

# Celery (added with this app — the project had no broker before)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Daily sync time (UTC) and per-platform minute offsets: meta,youtube,tiktok
SOCIAL_ANALYTICS_SYNC_HOUR=3
SOCIAL_ANALYTICS_SYNC_OFFSETS=0,20,40

# Fernet key encrypting stored platform tokens at rest. REQUIRED.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_ANALYTICS_FIELD_ENCRYPTION_KEY=

# Public base URL the OAuth providers redirect back to. Must be https and
# publicly reachable for real provider apps (use a tunnel in development).
SOCIAL_ANALYTICS_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional deep link the callback bounces to so the Flutter app can close the
# webview itself, e.g. socialanalytics://oauth-complete
SOCIAL_ANALYTICS_APP_REDIRECT=

# Meta — one app covers the Facebook Page and the linked Instagram account.
# Scopes: pages_show_list, pages_read_engagement, instagram_basic,
# instagram_manage_insights
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_REDIRECT_URI=

# YouTube — a separate Google OAuth client from GOOGLE_CLIENT_ID above
# (different scopes/consent screen). Scopes: youtube.readonly,
# yt-analytics.readonly
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# TikTok Login Kit — note "client key", not client id.
# Scopes: user.info.basic, user.info.stats, video.list
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

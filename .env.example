# Django
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ENV=development
SITE_URL=https://worldstories.net

# PostgreSQL
PGDATABASE=stories_db
PGUSER=postgres
PGPASSWORD=replace-with-your-database-password
PGHOST=127.0.0.1
PGPORT=5432

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
AWS_S3_CUSTOM_DOMAIN=

ANTHROPIC_API_KEY=

# Shared secret with the frontend's SSR loaders — must match the frontend's
# own SSR_INTERNAL_API_KEY. See core/libs/throttling.py.
SSR_INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Nepali companion site (see WORLDSTORIES_NEPALI_TODO.md)
# ---------------------------------------------------------------------------

# Public origin of the Nepali site. REQUIRED for /api/sitemap-np.xml — the
# route returns 503 rather than emitting URLs on the wrong domain, since a
# sitemap Search Console has already indexed is expensive to take back.
# Deliberately separate from SITE_URL, which belongs to worldstories.net.
NP_SITE_URL=

# Path wording on the Nepali site, used to build sitemap URLs. Defaults match
# the recommendation in the tracker (Latin-script slugs, Nepali visible
# labels); change here if that decision goes the other way — no code edit and
# no redeploy of the mother site needed.
NP_CATALOGUE_PATH=kathaharu
NP_STORY_PATH_PREFIX=katha

# Add the Nepali site's Netlify origins here once they exist; this already
# feeds both CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS in prod.py.
# EXTRA_ALLOWED_ORIGINS=https://ne.worldstories.net
